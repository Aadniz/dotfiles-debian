#!/usr/bin/env bash
# Shows the song that is currently playing.
#
# Only music players are shown: the apps listed in MUSIC_PLAYERS, plus any
# browser tab whose URL matches MUSIC_URL (YouTube Music). Everything else,
# such as youtube.com videos or VLC, is ignored.
#
# Clicks: left = previous, middle = play/pause, right = next, scroll = volume.
# Set LABEL to use one icon for every player.

PRIMARY_COLOR="${PRIMARY_COLOR:-#7d98ec}"
SECONDARY_COLOR="${SECONDARY_COLOR:-#CC7573}"

# MPRIS player name (lowercase) -> icon
declare -A MUSIC_PLAYERS=(
    [spotify]=""
    [elisa]=""
)

# Browsers report the tab URL, so YouTube Music can be told apart from YouTube.
MUSIC_URL='^https?://music\.youtube\.com([/?#]|$)'
MUSIC_URL_ICON=""

SHUFFLE_ICON=""

SEP=$'\x1f'
FORMAT="{{playerName}}$SEP{{playerInstance}}$SEP{{status}}$SEP{{xesam:url}}$SEP{{shuffle}}$SEP{{artist}}$SEP{{title}}"

# Sets instance, icon, shuffle, artist and title for the first music player
# that is playing. Returns 1 if there is none.
find_player() {
    local name status url
    while IFS=$SEP read -r name instance status url shuffle artist title; do
        [[ $status == Playing ]] || continue

        if [[ -v MUSIC_PLAYERS[${name,,}] ]]; then
            icon=${MUSIC_PLAYERS[${name,,}]}
        elif [[ $url =~ $MUSIC_URL ]]; then
            icon=$MUSIC_URL_ICON
        else
            continue
        fi

        return 0
    done < <(playerctl --all-players metadata --format "$FORMAT" 2>/dev/null)

    return 1
}

# Escapes text for pango markup.
escape() {
    local s=$1
    s=${s//'&'/'&amp;'}
    s=${s//'<'/'&lt;'}
    s=${s//'>'/'&gt;'}
    printf '%s' "$s"
}

find_player || exit 0

if [[ -n $BLOCK_BUTTON ]]; then
    case $BLOCK_BUTTON in
        1) playerctl --player="$instance" previous ;;
        2) playerctl --player="$instance" play-pause ;;
        3) playerctl --player="$instance" next ;;
        4) playerctl --player="$instance" volume 0.1+ ;;
        5) playerctl --player="$instance" volume 0.1- ;;
    esac

    # Give the player a moment to report the new song.
    sleep 0.2
    find_player || exit 0
fi

icon=${LABEL:-$icon}

details=$title
[[ -n $artist ]] && details="$artist - $title"
details=$(escape "$details")

shuffle_text=""
[[ $shuffle == true ]] && shuffle_text="  <span color='$SECONDARY_COLOR'>$SHUFFLE_ICON</span>"

# full_text, then short_text
echo "<span color='$PRIMARY_COLOR'>$icon</span>  $details$shuffle_text"
echo "<span color='$PRIMARY_COLOR'>$icon</span>"
